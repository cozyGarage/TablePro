#!/usr/bin/make -f

export DH_VERBOSE = 1
export CARGO_HOME = $(CURDIR)/debian/cargo-home
# Build from the linux/ workspace root (this debian/ lives under packaging/).
export TABLEPRO_LINUX = $(CURDIR)/../..

%:
	dh $@

override_dh_auto_configure:
	@true

override_dh_auto_build:
	cd $(TABLEPRO_LINUX) && cargo build --release -p tablepro-app -p tablepro-agentd --locked

override_dh_auto_test:
	cd $(TABLEPRO_LINUX) && cargo test --workspace --lib

override_dh_auto_install:
	install -Dm755 $(TABLEPRO_LINUX)/target/release/tablepro-app \
		$(CURDIR)/debian/tablepro/usr/bin/tablepro
	install -Dm755 $(TABLEPRO_LINUX)/target/release/tablepro-agentd \
		$(CURDIR)/debian/tablepro/usr/bin/tablepro-agentd
	install -Dm644 $(TABLEPRO_LINUX)/flatpak/com.tablepro.linux.desktop \
		$(CURDIR)/debian/tablepro/usr/share/applications/com.tablepro.linux.desktop
	install -Dm644 $(TABLEPRO_LINUX)/flatpak/com.tablepro.linux.metainfo.xml \
		$(CURDIR)/debian/tablepro/usr/share/metainfo/com.tablepro.linux.metainfo.xml
	install -Dm644 $(TABLEPRO_LINUX)/flatpak/icons/scalable/com.tablepro.linux.svg \
		$(CURDIR)/debian/tablepro/usr/share/icons/hicolor/scalable/apps/com.tablepro.linux.svg
	install -Dm644 $(TABLEPRO_LINUX)/packaging/policy.example.toml \
		$(CURDIR)/debian/tablepro/usr/share/doc/tablepro/policy.example.toml
	install -Dm644 $(TABLEPRO_LINUX)/LICENSE.md \
		$(CURDIR)/debian/tablepro/usr/share/doc/tablepro/LICENSE.md

override_dh_auto_clean:
	cd $(TABLEPRO_LINUX) && cargo clean || true
	rm -rf $(CARGO_HOME)
